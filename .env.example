# Contact form delivery — choose ONE option. These are server-only (never prefixed with NEXT_PUBLIC_).

# Option A: Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend; defaults to Resend's onboarding sender.
CONTACT_FROM_EMAIL=

# Option B: Formspree (https://formspree.io) — just the form ID, e.g. "abcdwxyz"
FORMSPREE_FORM_ID=

# Search engine ownership verification (paste only the token value, not the whole meta tag)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
